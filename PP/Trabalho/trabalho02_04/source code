#include <stdio.h>
#include <stdlib.h>

void funcao(int n) {
    for(int i = 0; i < n; i++) { 
        for(int j = 0; j < i+1; j++)
            printf("!");
        printf("\n");
    }
}

int main()
{   
    int n;
    
    scanf("%d", &n);
    if(n <= 0) {
        printf("Erro");
    }else {
        funcao(n);
    }
}